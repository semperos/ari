#!/usr/bin/env bash
set -e

REPO="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO"

# Upgrade Go-level dependency
go get -u codeberg.org/anaseto/goal
go mod tidy

# Use the exact module version pinned in go.mod, from the module cache.
go mod download codeberg.org/anaseto/goal
GOAL="$(go list -m -f '{{.Dir}}' codeberg.org/anaseto/goal)"
GOALVERSION="$(go list -m -f '{{.Version}}' codeberg.org/anaseto/goal)"
echo "Goal version: $GOALVERSION"

echo "Syncing Goal standard library files into libs/ from $GOAL/lib ..."
# Remove any previously-vendored Goal .goal files from libs/ by name before
# re-copying. This handles upstream renames and deletions cleanly without
# touching ari's own files in the same directory.
find "$GOAL/lib" -type f -name '*.goal' | while read -r src; do
    rm -f "$REPO/libs/$(basename "$src")"
done
find "$GOAL/lib" -type f -name '*.goal' | xargs -I {} cp {} "$REPO/libs/"
# Files in the module cache are read-only; make the copies writable.
chmod u+w "$REPO"/libs/*.goal

echo "Done. libs/ updated with Goal standard library files ($GOALVERSION)."
